# Allowed frontend origin(s) for CORS. Comma-separate multiple values — handy
# on Vercel where you'll usually want both your production domain and
# preview-deployment URLs allowed at once, e.g.:
#   CLIENT_URL=https://your-app.vercel.app,https://your-app-git-main-you.vercel.app
CLIENT_URL=http://localhost:5173

# Shared secret checked by routes/cronRoutes.js. Required if you deploy to
# Vercel: set this in both your Vercel project's env vars and vercel.json's
# scheduler request (Vercel Cron Jobs send it as configured, or set it up
# with an external scheduler using an `x-cron-secret` header). Not needed for
# local dev or traditional hosting, where node-cron runs the job in-process
# instead (see server.js).
CRON_SECRET=change_this_to_a_long_random_secret

# Minutes a generated password-reset link stays valid for.
RESET_TOKEN_EXPIRES_MINUTES=60

# Optional email delivery for admin-approved password resets. If left
# blank, the Admin Panel still works — the reset link / temporary password
# is shown once in the UI for the admin to copy and send manually.
# EMAIL_SERVER is a standard SMTP connection URL, e.g.:
#   smtp://username:password@smtp.yourprovider.com:587
EMAIL_SERVER= smtp://megalav2112@gmail.com:htqthqwxcddalzfd@smtp.gmail.com:587
EMAIL_FROM=megalav2112@gmail.com


